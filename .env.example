# CIPP MCP Server Configuration
#
# CIPP_BASE_URL must be the CIPP-API Azure Function App URL
# (https://<function-app-name>.azurewebsites.net), NOT the Static Web App /
# custom-domain UI URL (e.g. https://cipp.yourdomain.com). The SWA redirects
# bearer-token requests to its interactive login page, so API calls fail.
CIPP_BASE_URL=https://cippXXXXX.azurewebsites.net

# --- Authentication (choose ONE) -------------------------------------------
#
# Option A: Static Bearer token. Leave commented out if using OAuth below.
# CIPP_API_KEY=your-api-key-here
#
# Option B: OAuth 2.0 client-credentials against Entra ID. This is what the
# CIPP "API Clients" integration page issues — a client ID + secret registered
# in your CIPP tenant. The MCP server exchanges them for a short-lived access
# token on each request and caches it until expiry.
# CIPP_TENANT_ID=00000000-0000-0000-0000-000000000000
# CIPP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# CIPP_CLIENT_SECRET=your-client-secret-value
# CIPP_TOKEN_SCOPE=api://<client-id>/.default    # default; an explicit value disables fallback
# CIPP_TOKEN_SCOPE_FALLBACK=true                 # on 401, retry once with <clientId>/.default
# CIPP_TOKEN_URL=                                # override only for sovereign clouds

# Transport: stdio (default for Claude Desktop) or http (for gateway/remote use)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8080
# Bind address. When unset, the HTTP server binds 127.0.0.1. A configured
# CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# Without a real secret, MCP_ALLOW_INSECURE_DEV=1 always binds 127.0.0.1.
MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. Empty, whitespace, and known
# placeholders (changeme, your-s2s-secret, secret, placeholder, ${...}, …)
# are rejected and the process exits non-zero. Compose will not start when
# this is unset. Never commit a real value.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Logs a warning, does not enforce X-Gateway-S2S, and
# binds 127.0.0.1 only. Does not bypass a known placeholder.
# MCP_ALLOW_INSECURE_DEV=1

# Auth mode: env (default for stdio and single-tenant HTTP) or gateway
# (per-request headers; Docker image and the compose gateway service).
AUTH_MODE=env

# Logging
LOG_LEVEL=info
LOG_FORMAT=simple
